# Zone A is optional — the questionnaire, the buttons and the keyword + lexicon path all work with this file absent.
# Copy to .env and fill the key in to let the LLM fill the gaps the lexicon cannot (it is clamped to the catalogue
# vocabulary and can never introduce a term the catalogue lacks; it never touches Zone B).
ANTHROPIC_API_KEY=
# optional: the model used when a key is present (default claude-sonnet-5)
PERFUME_LLM_MODEL=
